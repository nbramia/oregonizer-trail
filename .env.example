# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/dbname

# Google OAuth Configuration (REQUIRED for Google login)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/authorize

# Flask Secret Key (optional - will auto-generate if not set)
# Generate with: python -c "import os; print(os.urandom(24).hex())"
# SECRET_KEY=your-secret-key-here

# Base Domain (optional - enables non-www to www redirect)
# BASE_DOMAIN=yourdomain.org
